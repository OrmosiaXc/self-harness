{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/high-level-design/traceability.schema.json",
  "title": "需求到设计追踪关系",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["requirement_id", "requirement_summary", "source_ids", "chapter_refs", "status"],
    "properties": {
      "requirement_id": { "type": "string", "minLength": 1 },
      "requirement_summary": { "type": "string", "minLength": 1 },
      "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "decision_refs": { "type": "array", "items": { "type": "string" } },
      "component_refs": { "type": "array", "items": { "type": "string" } },
      "chapter_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "status": { "type": "string", "enum": ["待设计", "已覆盖", "部分覆盖", "不适用"] }
    }
  }
}

