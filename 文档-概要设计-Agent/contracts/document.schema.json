{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/high-level-design/document.schema.json",
  "title": "概要设计文档结构",
  "type": "object",
  "required": ["document_name", "chapters", "sources", "quality_status"],
  "properties": {
    "document_name": { "type": "string", "minLength": 1 },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "status", "path"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["待编写", "编写中", "需完善", "已完成"] },
          "path": { "type": "string", "minLength": 1 },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "open_questions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sources": { "type": "array", "items": { "type": "string" } },
    "quality_status": { "type": "string", "enum": ["unchecked", "failed", "passed"] }
  }
}

