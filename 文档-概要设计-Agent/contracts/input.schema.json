{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/high-level-design/input.schema.json",
  "title": "概要设计任务输入",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_name", "project_name", "output_formats"],
  "properties": {
    "document_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "project_name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "mode": { "type": "string", "enum": ["standard", "automatic"], "default": "standard" },
    "chapter_profile": {
      "type": "string",
      "enum": ["technical-spec", "full-standard"],
      "default": "technical-spec"
    },
    "output_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["markdown", "docx"] }
    },
    "must_include": { "type": "array", "items": { "type": "string" } },
    "must_exclude": { "type": "array", "items": { "type": "string" } },
    "reference_forbidden_terms": { "type": "array", "items": { "type": "string" } },
    "local_resource_dependency": {
      "type": "string",
      "enum": ["omit", "logical-only"],
      "default": "omit",
      "description": "默认不在交付内容中暴露参考文件载体；只有用户明确要求时才启用不含本机绝对路径的逻辑依赖说明"
    },
    "content_depth_gate": { "type": "boolean", "default": true },
    "chapter_preview": { "type": "boolean", "default": true },
    "history_policy": {
      "type": "string",
      "enum": ["keep-all", "keep-current-after-explicit-approval"],
      "default": "keep-all"
    },
    "publish_directory": { "type": "string" },
    "external_source_index": { "type": "string" },
    "audiences": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
